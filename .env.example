# Admin login password (this is the ONLY secret for the admin panel)
ADMIN_PASSWORD=tu_password_segura

# Secret used to sign JWT tokens. Generate your own: `openssl rand -hex 32`
JWT_SECRET=reemplaza_con_un_valor_generado_con_openssl_rand_hex_32

# Supabase (Project Settings -> API)
SUPABASE_URL=https://tu-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key